# docker/.env.example
# Copy to docker/.env (never commit docker/.env).

# Required. Generate with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Runs TimeScribe as a web app (no Electron). The image already sets it.
APP_RUNTIME=web

APP_URL=http://localhost:8080
TIMESCRIBE_PORT=8080

# Day/week boundaries and overtime are computed in this timezone.
APP_TIMEZONE=UTC
TZ=UTC
APP_LOCALE=en_US

QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=file

# Desktop-only features
NATIVEPHP_UPDATER_ENABLED=false

# Telemetry: leave empty to keep it disabled
SENTRY_LARAVEL_DSN=
NIGHTWATCH_TOKEN=
GOOGLE_ANALYTICS_ID=